{
  "manifest_version": 2,
  "name": "Snapcast video detector",
  "description": "Finds the video streams of the pages you browse so Snapcast can list and cast them.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "detector@snapcast.app"
    }
  },
  "permissions": [
    "webRequest",
    "<all_urls>",
    "tabs",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "background": {
    "scripts": ["classify.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["classify.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
