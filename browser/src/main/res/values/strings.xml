    <string name="browser_error_crashed_title">The page crashed</string>
    <string name="browser_error_crashed_message">The content process for this page stopped unexpectedly.</string>
    <string name="browser_error_proxy_title">Proxy server problem</string>
    <string name="browser_error_proxy_message">The proxy server is refusing connections or could not be found. Check your network\'s proxy settings.</string>
    <string name="browser_error_port_title">This address is restricted</string>
    <string name="browser_error_port_message">The address uses a network port that is normally used for something other than web browsing, so the request was cancelled for your protection.</string>
    <string name="browser_error_local_network_title">Local network access blocked</string>
    <string name="browser_error_local_network_message">The page tried to reach a device on your local network and was not allowed to.</string>
