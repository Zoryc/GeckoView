<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Framework-only theme (no AppCompat / Material Components in this module). Compose draws the UI;
      the window just needs to be black, title-less and drawn behind the (hidden) system bars.
    -->
    <style name="Theme.Snapcast.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
