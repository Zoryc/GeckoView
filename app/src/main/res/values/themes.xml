<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      AppCompat-derived theme: the Cast MediaRouteButton and its device chooser dialog require one.
      Compose draws the actual UI with its own Material 3 color scheme.
    -->
    <style name="Theme.Snapcast" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/snapcast_primary</item>
        <item name="colorOnPrimary">@color/snapcast_on_primary</item>
        <item name="android:windowBackground">@color/snapcast_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
